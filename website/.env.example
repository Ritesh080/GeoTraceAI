NEXT_PUBLIC_GEOTRACE_API_URL=http://127.0.0.1:8000
GEOTRACE_ALLOWED_ORIGINS=http://127.0.0.1:3000
GEOTRACE_ANALYSIS_CONCURRENCY=2
GEOTRACE_DEPLOYMENT_LABEL=local-development
GEOTRACE_STREET_RADIUS_KM=10
GEOTRACE_INSTAGRAM_ENABLED=true
INSTAGRAM_USERNAME=YOUR_INSTAGRAM_USERNAME
# For hosted deployment, store a base64-encoded Instaloader session as a sealed secret.
# INSTALOADER_SESSION_BASE64=
# Local alternative: INSTALOADER_SESSION_FILE=/absolute/path/to/session-YOUR_INSTAGRAM_USERNAME
# GEOTRACE_VISUAL_MODEL_PATH=/data/geotrace_visual_v0.npz
# GEOTRACE_MAP_INDEX_PATH=/data/geotrace_places_v0.npz
# GEOTRACE_STREET_INDEX_PATH=/data/geotrace_street_v0.npz
# GEOTRACE_PROVENANCE_INDEX_PATH=/data/geotrace_provenance_v0.npz
# GEOTRACE_CALIBRATION_PATH=/data/geotrace_calibration_v0.npz
